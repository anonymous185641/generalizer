	q1->q2 [label="sendto(A0,syncAccess)[3]"];
	q2->q4 [label="sendto(A1,setup)[2]"];
	q1->q3 [label="sendto(A1,setup)[2]"];
	q3->q4 [label="sendto(A0,syncAccess)[3]"];
	q4->q0 [label="recvfrom(A0,logout)[5]"];
}