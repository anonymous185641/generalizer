digraph G {
compound=true;
rankdir=lr;
	init [shape=point];
	q0 [shape=doublecircle];
	q1 [shape=circle];
	q2 [shape=circle];
	q3 [shape=circle];
	q4 [shape=circle];
	init->q0;
	q0->q1 [label="sendto(A2,connect)[1]"];
	q1->q2 [label="recvfrom(A2,syncAccess)[3]"];
	q2->q2 [label="sendto(A1,access)[4]"];
	q2->q3 [label="sendto(A2,logout)[5]"];
	q3->q4 [label="sendto(A1,syncLogout)[7]"];
	q4->q0 [label="recvfrom(A1,syncLog)[6]"];
}