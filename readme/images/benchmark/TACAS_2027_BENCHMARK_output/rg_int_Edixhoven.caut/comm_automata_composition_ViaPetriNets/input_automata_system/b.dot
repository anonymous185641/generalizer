digraph G {
compound=true;
rankdir=lr;
	init [shape=point];
	q0 [shape=circle];
	q1 [shape=circle];
	q2 [shape=circle];
	q4 [shape=doublecircle];
	q3 [shape=circle];
	init->q0;
	q0->q1 [label="recvfrom(a,int)[1]"];
	q1->q2 [label="recvfrom(a,bool)[2]"];
	q2->q4 [label="sendto(a,yes)[3]"];
	q2->q4 [label="sendto(a,no)[4]"];
	q1->q3 [label="sendto(a,yes)[3]"];
	q1->q3 [label="sendto(a,no)[4]"];
	q3->q4 [label="recvfrom(a,bool)[2]"];
}