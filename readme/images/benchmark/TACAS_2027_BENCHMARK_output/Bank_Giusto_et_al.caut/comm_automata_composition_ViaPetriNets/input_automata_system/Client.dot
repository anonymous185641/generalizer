digraph G {
compound=true;
rankdir=lr;
	init [shape=point];
	q0 [shape=doublecircle];
	q1 [shape=circle];
	q2 [shape=circle];
	q3 [shape=circle];
	q4 [shape=circle];
	init->q0;
	q0->q1 [label="sendto(Seller,askprice)[1]"];
	q1->q0 [label="recvfrom(Seller,price)[2]"];
	q0->q2 [label="sendto(Seller,buy)[3]"];
	q2->q3 [label="recvfrom(Bank,askpay)[4]"];
	q3->q4 [label="sendto(Bank,infopay)[5]"];
	q4->q0 [label="recvfrom(Seller,cancel)[6]"];
	q4->q0 [label="recvfrom(Seller,conf)[7]"];
}