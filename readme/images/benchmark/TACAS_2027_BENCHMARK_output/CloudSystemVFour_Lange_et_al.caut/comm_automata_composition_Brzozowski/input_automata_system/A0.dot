digraph G {
compound=true;
rankdir=lr;
	init [shape=point];
	q0 [shape=doublecircle];
	q1a [shape=circle];
	q1 [shape=circle];
	q0c [shape=circle];
	q0b [shape=circle];
	init->q0;
	q0->q1a [label="sendto(A2,connect)[1]"];
	q1a->q1 [label="recvfrom(A2,syncAccess)[2]"];
	q1->q1 [label="sendto(A1,access)[3]"];
	q1->q0c [label="sendto(A2,logout)[4]"];
	q0c->q0b [label="sendto(A1,syncLogout)[5]"];
	q0b->q0 [label="recvfrom(A1,syncLog)[6]"];
}