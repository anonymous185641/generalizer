digraph G {
compound=true;
rankdir=lr;
	init [shape=point];
	q0 [shape=doublecircle];
	q1 [shape=circle];
	q2a [shape=circle];
	q2 [shape=circle];
	init->q0;
	q0->q1 [label="recvfrom(A0,connect)[1]"];
	q1->q2a [label="sendto(A1,setup)[7]"];
	q2a->q2 [label="sendto(A0,syncAccess)[2]"];
	q2->q0 [label="recvfrom(A0,logout)[4]"];
}