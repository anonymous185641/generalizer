digraph G {
compound=true;
rankdir=lr;
	init [shape=point];
	q0 [shape=doublecircle];
	q1 [shape=circle];
	q2 [shape=circle];
	q3 [shape=circle];
	init->q0;
	q0->q1 [label="recvfrom(Client,req)[1]"];
	q1->q2 [label="sendto(Client,res)[2]"];
	q2->q3 [label="recvfrom(Client,acks)[3]"];
	q3->q0 [label="sendto(Database,logs)[4]"];
}